# Переменные задаются в docker-compose (см. .env.example):
#   DOMAIN — продуктыдома.рф (xn--80ahaxliddjxj2h.xn--p1ai)
#
# E-mail для ACME необязателен (Let's Encrypt выпустит сертификат без contact).
# Для уведомлений LE раскомментируйте блок ниже с реальным ящиком (не .local):
# {
# 	email you@gmail.com
# }

{$DOMAIN} {
	encode gzip

	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
