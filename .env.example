# Скопируйте в .env рядом с docker-compose.yml
# Пароль задаётся только при первом создании тома postgres_data; потом менять
# его здесь недостаточно — backend не подключится к БД. Без @ : / # в пароле.
POSTGRES_PASSWORD=change_me
# Адрес интерфейса хоста, на котором слушает БД (0.0.0.0 — все интерфейсы)
POSTGRES_BIND_ADDR=0.0.0.0
# Внешний порт БД на хосте
POSTGRES_PUBLIC_PORT=15432
# Ключ подписи JWT, которым бэкенд подписывает токены входа
JWT_SECRET=change_me

# HTTPS через Caddy (сервис caddy в docker-compose)
# Сайт: https://продуктыдома.рф — в DNS A/AAAA на IP сервера; для Caddy punycode:
DOMAIN=xn--80ahaxliddjxj2h.xn--p1ai
# Порты на хосте (если 80/443 заняты)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
